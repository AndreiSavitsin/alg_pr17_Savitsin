<Window x:Class="pr17_Savitsin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr17_Savitsin"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Menu HorizontalAlignment="Left" Height="55" VerticalAlignment="Top" Width="107">
            <MenuItem Header="Задание 1" Click="Task1"/>
            <MenuItem Header="Задание 2" Click="Task2"/>
            <MenuItem Header="Выход" Click="Exit"></MenuItem>
        </Menu>

        <StackPanel x:Name="PanelTask1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Height="188" Width="294" Margin="142,42,0,0" RenderTransformOrigin="0.5,0.5" Visibility="Hidden">
            <Label Content="Задание 1" Foreground="White" Background="Green"></Label>
            <TextBox x:Name="txtText" Height="75" IsReadOnly="True"></TextBox>
            <TextBox x:Name="txtWord" ToolTip="Введите слово" Height="22"></TextBox>
            <TextBox x:Name="txtResult" IsReadOnly="True" Height="24"></TextBox>
            <Button Content="Поиск слова" Click="btnSearch" Foreground="White" Background="Green" Height="28"></Button>
        </StackPanel>

        <StackPanel x:Name="PanelTask2" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,42,0,0" Height="171" Width="288" Visibility="Hidden">
            <Label Content="Задание 2" Foreground="White" Background="Green" Height="25"></Label>
            <TextBox x:Name="txtText2" ToolTip="Введите текст, содержащий /" Height="25"></TextBox>
            <TextBox x:Name="txtResult2_1" IsReadOnly="True" Height="25"></TextBox>
            <TextBox x:Name="txtResult2_2" IsReadOnly="True" Height="25"></TextBox>
            <TextBox x:Name="txtResult2_3" IsReadOnly="True" Height="25"></TextBox>
            <Button Content="Начать" Click="btnStart" Foreground="White" Background="Green" Height="25"></Button>
        </StackPanel>
    </Grid>
</Window>
